{
  "expo": {
    "name": "SocialQuest",
    "slug": "socialquest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "socialquest",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialquest.app"
    },
    "android": {
      "package": "com.socialquest.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SocialQuest uses your photos only when you choose one to share in a post.",
          "cameraPermission": "SocialQuest uses your camera only when you choose to take a photo for a post."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SocialQuest uses your location to suggest a venue when you host, find nearby events, or tag a post. You can also enter a place manually."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "activity",
          "color": "#9a65ff"
        }
      ]
    ],
    "extra": {}
  }
}
